{
  "name": "ai-visibility-platform",
  "version": "0.1.0",
  "description": "Experience Intelligence for AI Discovery, Understanding, Trust, and Recommendation",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "install:all": "npm install && cd backend && npm install",
