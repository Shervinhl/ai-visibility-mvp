# AI Visibility Check v2 - backend configuration (Part H).
# Copy to .env (never commit .env). Every value has a safe default except the provider keys.

# --- Technical checks ---------------------------------------------------------
V2_MAX_REQUESTS_PER_CHECK=50
V2_MAX_KEY_PAGES=20
# A3 thresholds (starting values; calibrate on pilot sites). Changing them creates a new check version.
V2_RENDER_WORD_THRESHOLD=200
V2_RENDER_RAW_RATIO=0.5
# Politeness delay between requests to the audited site (does not change results).
V2_REQUEST_DELAY_MS=500

# --- AI answer tests ----------------------------------------------------------
V2_AI_RUNS_PER_QUESTION=3
V2_AI_TIMEOUT_MS=60000
V2_MIN_VALID_RUNS_TO_REPORT=2
V2_MIN_ANSWERS_FOR_COMPARISON=10
V2_AI_MAX_TOKENS=1024
V2_AI_CONCURRENCY=2

# Models (check each provider's model list; change here, not in code).
V2_ANTHROPIC_MODEL=claude-sonnet-5-5
V2_OPENAI_MODEL=gpt-4.1
V2_GEMINI_MODEL=gemini-2.5-flash

# Provider keys - at least two are needed to run AI tests. Never commit real keys.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Server -------------------------------------------------------------------
V2_PORT=3000
V2_CORS_ORIGIN=http://localhost:3001
# V2_DB_PATH=./data/v2.sqlite
